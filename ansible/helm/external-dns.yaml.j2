---
apiVersion: v1
kind: Namespace
metadata:
   name: external-dns
   labels:
      name: external-dns

---
apiVersion: v1
kind: Secret
metadata:
  namespace: external-dns
  name: rfc2136-keys
stringData:
  rfc2136-tsig-keyname: "{{ externaldns_key_name }}"
  rfc2136-tsig-secret: "{{ externaldns_key_secret }}"

---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: external-dns
  namespace: kube-system
spec:
  repo: https://kubernetes-sigs.github.io/external-dns/
  chart: external-dns
  targetNamespace: external-dns
  version: "{{ externaldns_chart_version }}"
  valuesContent: |-
    provider: rfc2136
    policy: sync # default: upsert-only
    extraArgs:
      - --rfc2136-host={{ externaldns_server }}
      - --rfc2136-port=53
      - --rfc2136-zone={{ externaldns_dns_zone }}
      - --rfc2136-tsig-secret-alg={{ externaldns_key_algorithm | default("hmac-sha256") }}
      - --rfc2136-tsig-axfr
      - --service-type-filter=LoadBalancer
      - --service-type-filter=NodePort
    env:
      - name: "EXTERNAL_DNS_RFC2136_TSIG_SECRET"
        valueFrom:
          secretKeyRef:
            name: rfc2136-keys
            key: rfc2136-tsig-secret
      - name: "EXTERNAL_DNS_RFC2136_TSIG_KEYNAME"
        valueFrom:
          secretKeyRef:
            name: rfc2136-keys
            key: rfc2136-tsig-keyname
    domainFilters:
      - {{ externaldns_dns_zone | regex_replace('\\.$', '') }}
    sources:
      - traefik-proxy
      - service # See extraArgs: --service-type-filter
