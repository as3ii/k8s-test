---
nodes:
  hosts: # DNS or IP allowed
    kube-0.domain.com:
    kube-1.domain.com:
    kube-2.domain.com:

all:
  vars:
    # VIP variables
    api_domain: kube.domain.com # Used for the SAN certificate
    api_ip: 10.0.0.100
    kubevip_iprange: 10.0.0.101,10.0.0.150
    kubevip_version: v1.0.4
    # K3s variables
    token: asdfg-superSECRET-123456789
    k3s_version: v1.35.1+k3s1
    # Ansible stuff
    ansible_ssh_user: root
    ansible_ssh_private_key_file: ~/.ssh/id_rsa-nixos-as3ii
