proxmox_api_url          = "https://a.b.c.d:8006/api2/json"
proxmox_api_token_id     = "user@pam!name"
proxmox_api_token_secret = "secret"

ssh_public_keys = [
  "~/.ssh/id_ed25519.pub"
]
password = "secret_password"

proxmox_node = "pve"

template = "debian13"
nodes = [
  {
    name    = "kube-0"
    id      = 0
    network = "ip=10.0.0.10/24,gw=10.0.0.1"
  },
  {
    name    = "kube-1"
    id      = 0
    network = "ip=10.0.0.11/24,gw=10.0.0.1"
  },
  {
    name    = "kube-2"
    id      = 0
    network = "ip=10.0.0.12/24,gw=10.0.0.1"
  },
]
nameserver   = "9.9.9.9"
searchdomain = "mydomain.com" # Optional
